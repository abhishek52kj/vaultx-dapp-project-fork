# ─── App ────────────────────────────────────────────────────────────────────
VITE_APP_NAME=VaultX
VITE_TOKEN_SYMBOL=VTX
VITE_TOKEN_NAME=VaultX

# ─── Deployed contract addresses (fill in after `npm run deploy`) ───────────
VITE_TOKEN_ADDRESS=
VITE_PRESALE_ADDRESS=
VITE_NFT_ADDRESS=
# VITE_STAKING_ADDRESS=

# ─── Block-explorer API keys (optional — improves rate limits) ───────────────
# Get a free key at https://etherscan.io/myapikey  (also works for BSCscan/Polygonscan)
VITE_EXPLORER_API_KEY=

# ─── 1inch Swap API (optional — public endpoints work without a key) ─────────
# Register at https://portal.1inch.dev/ for a free key
VITE_ONEINCH_API_KEY=
